{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/asticore/engage-templates/main/schema/library.schema.json",
  "title": "Engage template library manifest",
  "description": "library.json (format engage-library), generated by scripts/build.mjs. The Engage builder lists the items from this file. Paths are relative to the library folder.",
  "type": "object",
  "required": ["format", "schemaVersion", "name", "items"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "engage-library" },
    "schemaVersion": { "const": 1 },
    "name": {
      "type": "string",
      "pattern": "\\S",
      "maxLength": 120
    },
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*%)(?!(.*/)?\\.\\.(/|$))[^\\u0000]+$"
    },
    "item": {
      "type": "object",
      "required": ["slug", "kind", "title", "preview", "file"],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "kind": { "enum": ["section", "page"] },
        "title": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "maxLength": 60,
          "description": "Display label. Defaults to General when omitted."
        },
        "tags": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "preview": {
          "allOf": [
            { "$ref": "#/$defs/relativePath" },
            { "type": "string", "pattern": "\\.(png|jpe?g|webp)$" }
          ],
          "description": "PNG, JPEG or WebP picture, up to 2 MB."
        },
        "file": {
          "allOf": [
            { "$ref": "#/$defs/relativePath" },
            { "type": "string", "pattern": "\\.json$" }
          ],
          "description": "engage-template item file, up to 1 MB."
        }
      }
    }
  }
}
