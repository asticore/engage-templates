{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/asticore/engage-templates/main/schema/catalog.schema.json",
  "title": "Engage template catalog",
  "description": "catalog.json, generated by scripts/build.mjs. Search index with descriptions, industries, styles and framework links. Enums mirror taxonomy/categories.json and taxonomy/styles.json.",
  "type": "object",
  "required": ["name", "schemaVersion", "frameworks", "categories", "styles", "items"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "\\S", "maxLength": 120 },
    "schemaVersion": { "const": 1 },
    "frameworks": {
      "type": "object",
      "required": ["shine", "effix"],
      "additionalProperties": false,
      "properties": {
        "shine": { "$ref": "#/$defs/framework" },
        "effix": {
          "type": "object",
          "required": ["css", "js", "repo"],
          "additionalProperties": false,
          "properties": {
            "css": { "$ref": "#/$defs/url" },
            "js": { "$ref": "#/$defs/url" },
            "repo": { "$ref": "#/$defs/url" }
          }
        }
      }
    },
    "categories": {
      "type": "object",
      "required": ["sections", "pages"],
      "additionalProperties": false,
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "description", "keywords", "count"],
            "additionalProperties": false,
            "properties": {
              "id": { "enum": ["announcement", "header", "hero", "logos", "features", "content", "stats", "process", "testimonials", "pricing", "team", "faq", "cta", "newsletter", "contact", "gallery", "blog", "commerce", "footer"] },
              "label": { "type": "string" },
              "description": { "type": "string" },
              "keywords": { "type": "array", "items": { "type": "string" } },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "description", "keywords", "count"],
            "additionalProperties": false,
            "properties": {
              "id": { "enum": ["landing", "business", "about", "services", "contact-page", "pricing-page", "portfolio", "hospitality", "events", "health", "shop"] },
              "label": { "type": "string" },
              "description": { "type": "string" },
              "keywords": { "type": "array", "items": { "type": "string" } },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "styles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "theme", "colors", "fonts"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["shine-light", "shine-dark", "ocean", "sunset", "forest", "mono", "luxe", "candy"] },
          "label": { "type": "string" },
          "theme": { "enum": ["light", "dark", "mixed"] },
          "colors": {
            "type": "object",
            "required": ["primary", "onPrimary", "secondary", "accent", "bg", "surface", "surface2", "text", "muted", "border"],
            "properties": {
              "primary": { "$ref": "#/$defs/color" },
              "onPrimary": { "$ref": "#/$defs/color" },
              "secondary": { "$ref": "#/$defs/color" },
              "accent": { "$ref": "#/$defs/color" },
              "bg": { "$ref": "#/$defs/color" },
              "surface": { "$ref": "#/$defs/color" },
              "surface2": { "$ref": "#/$defs/color" },
              "text": { "$ref": "#/$defs/color" },
              "muted": { "$ref": "#/$defs/color" },
              "border": { "$ref": "#/$defs/color" },
              "dark": { "$ref": "#/$defs/color" }
            },
            "additionalProperties": false
          },
          "fonts": {
            "type": "object",
            "required": ["heading", "body"],
            "additionalProperties": false,
            "properties": {
              "heading": { "enum": ["inter", "montserrat", "jost", "playfair", "cormorant", "cinzel"] },
              "body": { "enum": ["inter", "montserrat", "jost", "playfair", "cormorant", "cinzel"] }
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "kind", "title", "category", "categoryLabel", "description", "tags", "industry", "theme", "style", "frameworks", "preview", "file"],
        "additionalProperties": false,
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "kind": { "enum": ["section", "page"] },
          "title": { "type": "string", "pattern": "\\S", "maxLength": 120 },
          "category": { "type": "string" },
          "categoryLabel": { "type": "string", "maxLength": 60 },
          "description": { "type": "string", "minLength": 10, "maxLength": 300 },
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9 -]{0,39}$" }
          },
          "industry": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": ["saas", "ai", "agency", "ecommerce", "fintech", "devtools", "media", "education", "health", "fitness", "restaurant", "real-estate", "legal", "events", "travel", "nonprofit", "personal", "general"]
            }
          },
          "theme": { "enum": ["light", "dark", "mixed"] },
          "style": { "enum": ["shine-light", "shine-dark", "ocean", "sunset", "forest", "mono", "luxe", "candy"] },
          "frameworks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["shine", "effix"] }
          },
          "sections": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
          },
          "preview": {
            "type": "string",
            "pattern": "^previews/[a-z0-9][a-z0-9-]{0,63}\\.(png|jpe?g|webp)$"
          },
          "file": {
            "type": "string",
            "pattern": "^items/[a-z0-9][a-z0-9-]{0,63}\\.json$"
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "section" } }, "required": ["kind"] },
            "then": {
              "properties": {
                "category": { "enum": ["announcement", "header", "hero", "logos", "features", "content", "stats", "process", "testimonials", "pricing", "team", "faq", "cta", "newsletter", "contact", "gallery", "blog", "commerce", "footer"] }
              }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "page" } }, "required": ["kind"] },
            "then": {
              "properties": {
                "category": { "enum": ["landing", "business", "about", "services", "contact-page", "pricing-page", "portfolio", "hospitality", "events", "health", "shop"] }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "framework": {
      "type": "object",
      "required": ["css", "repo"],
      "additionalProperties": false,
      "properties": {
        "css": { "$ref": "#/$defs/url" },
        "repo": { "$ref": "#/$defs/url" }
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    }
  }
}
