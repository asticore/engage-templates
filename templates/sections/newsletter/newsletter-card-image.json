{
  "meta": {
    "slug": "newsletter-card-image",
    "kind": "section",
    "category": "newsletter",
    "frameworks": [
      "shine",
      "effix"
    ],
    "version": "1.0.0",
    "title": "Newsletter card over a photo background",
    "description": "A centred card on a darkened photo with a heading, short pitch and the site sign-up form. Choose your form inside the card after inserting; padding tightens on mobile.",
    "tags": [
      "newsletter",
      "card",
      "photo",
      "overlay",
      "form",
      "dark"
    ],
    "industry": [
      "restaurant",
      "travel",
      "general"
    ],
    "style": "luxe"
  },
  "tree": [
    {
      "blockType": "section",
      "design": {
        "paddingTop": 112,
        "paddingBottom": 112,
        "mobile": {
          "paddingTop": 56,
          "paddingBottom": 56
        },
        "fontFamily": "{{font.body}}",
        "bgType": "image",
        "bgImageUrl": "img:coffee-shop@1800",
        "overlayType": "color",
        "overlayColor": "#000000",
        "overlayOpacity": 55,
        "kenBurns": "zoom-in",
        "textColor": "{{color.text}}",
        "layout": {
          "display": "columns",
          "direction": {
            "desktop": "row",
            "mobile": "column"
          },
          "gap": {
            "desktop": 48,
            "mobile": 32
          },
          "alignItems": "center",
          "contentWidth": "boxed",
          "boxedWidth": 1100,
          "justify": "center"
        }
      },
      "columns": [
        {
          "label": "Card",
          "width": 8,
          "layout": {
            "gap": 16
          },
          "design": {
            "paddingTop": 48,
            "paddingBottom": 48,
            "paddingLeft": 40,
            "paddingRight": 40,
            "mobile": {
              "paddingTop": 28,
              "paddingBottom": 28,
              "paddingLeft": 20,
              "paddingRight": 20
            },
            "bgType": "color",
            "bgColor": "{{color.surface}}",
            "borderRadius": "{{radius}}",
            "borderWidth": 1,
            "borderStyle": "solid",
            "borderColor": "{{color.border}}",
            "glass": true,
            "glassBlur": 16,
            "boxShadow": "lg",
            "reveal": "zoom"
          },
          "blocks": [
            {
              "blockType": "element",
              "elementType": "heading",
              "props": {
                "text": "Stay in the loop",
                "tag": "h6",
                "align": "center",
                "effect": "none"
              },
              "design": {
                "textColor": "{{color.primary}}",
                "textTransform": "uppercase",
                "letterSpacing": 2,
                "fontWeight": 700,
                "fontSize": 13
              }
            },
            {
              "blockType": "element",
              "elementType": "heading",
              "props": {
                "text": "Seasonal menus and secret tastings, first",
                "tag": "h2",
                "align": "center",
                "effect": "none"
              },
              "design": {
                "fontFamily": "{{font.heading}}",
                "fontSize": 40,
                "fontWeight": 700,
                "lineHeight": 1.12,
                "letterSpacing": -0.5,
                "mobile": {
                  "fontSize": 30
                },
                "reveal": "fade-up"
              }
            },
            {
              "blockType": "element",
              "elementType": "text-editor",
              "props": {
                "align": "center",
                "content": "Join the list and get invitations before the doors open to everyone."
              },
              "design": {
                "textColor": "{{color.text}}",
                "fontSize": 17,
                "lineHeight": 1.65,
                "reveal": "fade-up",
                "revealDelay": 2
              }
            },
            {
              "blockType": "form",
              "showTitle": false
            }
          ]
        }
      ]
    }
  ]
}
