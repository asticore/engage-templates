{
  "meta": {
    "slug": "hero-split-photo",
    "kind": "section",
    "title": "Split hero with photo",
    "category": "hero",
    "description": "Headline, supporting text and two buttons on the left; a large rounded photo on the right. Stacks on mobile.",
    "tags": ["hero", "split", "photo", "two buttons"],
    "industry": ["saas", "agency", "general"],
    "style": "shine-light",
    "frameworks": ["shine", "effix"]
  },
  "tree": [
    {
      "blockType": "section",
      "design": {
        "bgType": "color",
        "bgColor": "{{color.bg}}",
        "textColor": "{{color.text}}",
        "fontFamily": "{{font.body}}",
        "paddingTop": 96,
        "paddingBottom": 96,
        "mobile": { "paddingTop": 56, "paddingBottom": 56 },
        "layout": { "display": "columns", "direction": { "desktop": "row", "mobile": "column" }, "gap": { "desktop": 48, "mobile": 32 }, "alignItems": "center", "contentWidth": "boxed", "boxedWidth": 1200 }
      },
      "columns": [
        {
          "label": "Copy",
          "width": 6,
          "layout": { "gap": 20, "vAlign": "middle" },
          "blocks": [
            { "blockType": "element", "elementType": "heading", "props": { "text": "New in 2026", "tag": "h6", "align": "left", "effect": "none" }, "design": { "textColor": "{{color.primary}}", "textTransform": "uppercase", "letterSpacing": 2, "fontWeight": 700, "fontSize": 13 } },
            { "blockType": "element", "elementType": "heading", "props": { "text": "Build pages your customers remember", "tag": "h1", "align": "left", "effect": "none" }, "design": { "fontFamily": "{{font.heading}}", "fontSize": 56, "fontWeight": 800, "lineHeight": 1.05, "letterSpacing": -1, "mobile": { "fontSize": 38 }, "reveal": "fade-up" } },
            { "blockType": "element", "elementType": "text-editor", "props": { "align": "left", "content": "Launch faster with sections that already look right. Swap the words, keep the polish." }, "design": { "textColor": "{{color.muted}}", "fontSize": 19, "lineHeight": 1.6, "reveal": "fade-up", "revealDelay": 2 } },
            {
              "blockType": "section",
              "design": { "layout": { "display": "columns", "direction": { "desktop": "row", "mobile": "row" }, "gap": { "desktop": 12 }, "justify": "start", "wrap": true }, "reveal": "fade-up", "revealDelay": 4 },
              "columns": [
                { "widthDesktop": { "value": 0, "unit": "auto" }, "widthMobile": { "value": 0, "unit": "auto" }, "blocks": [ { "blockType": "element", "elementType": "button", "props": { "text": "Start free", "url": "/signup", "variant": "primary", "size": "lg", "align": "left" }, "design": { "pointerFx": "magnetic" } } ] },
                { "widthDesktop": { "value": 0, "unit": "auto" }, "widthMobile": { "value": 0, "unit": "auto" }, "blocks": [ { "blockType": "element", "elementType": "button", "props": { "text": "See how it works", "url": "#how", "variant": "secondary", "size": "lg", "align": "left" } } ] }
              ]
            }
          ]
        },
        {
          "label": "Photo",
          "width": 6,
          "blocks": [
            { "blockType": "element", "elementType": "image", "props": { "image": "img:team-laptop@1400|Team working together on laptops", "alt": "Team working together on laptops", "ratio": "4:3", "fit": "cover", "width": 100, "align": "center" }, "design": { "borderRadius": "{{radius}}", "boxShadow": "lg", "reveal": "zoom", "pointerFx": "tilt", "pointerFxStrength": 20 } }
          ]
        }
      ]
    }
  ]
}
