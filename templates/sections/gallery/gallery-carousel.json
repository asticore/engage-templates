{
  "meta": {
    "slug": "gallery-carousel",
    "kind": "section",
    "category": "gallery",
    "frameworks": [
      "shine",
      "effix"
    ],
    "version": "1.0.0",
    "title": "Photo carousel with captions",
    "description": "A swipeable carousel of five landscape photos, each with its caption and arrows. Shows one photo at a time on mobile.",
    "tags": [
      "gallery",
      "carousel",
      "captions",
      "photos",
      "animated"
    ],
    "industry": [
      "travel",
      "general",
      "media"
    ],
    "style": "sunset"
  },
  "tree": [
    {
      "blockType": "section",
      "design": {
        "paddingTop": 96,
        "paddingBottom": 96,
        "mobile": {
          "paddingTop": 56,
          "paddingBottom": 56
        },
        "fontFamily": "{{font.body}}",
        "bgType": "color",
        "bgColor": "{{color.bg}}",
        "textColor": "{{color.text}}",
        "layout": {
          "display": "columns",
          "direction": {
            "desktop": "column",
            "mobile": "column"
          },
          "gap": {
            "desktop": 40,
            "mobile": 28
          },
          "alignItems": "stretch",
          "contentWidth": "boxed",
          "boxedWidth": 1100
        }
      },
      "columns": [
        {
          "label": "Heading",
          "width": 12,
          "layout": {
            "gap": 12
          },
          "blocks": [
            {
              "blockType": "element",
              "elementType": "heading",
              "props": {
                "text": "Field notes",
                "tag": "h6",
                "align": "center",
                "effect": "none"
              },
              "design": {
                "textColor": "{{color.primary}}",
                "textTransform": "uppercase",
                "letterSpacing": 2,
                "fontWeight": 700,
                "fontSize": 13
              }
            },
            {
              "blockType": "element",
              "elementType": "heading",
              "props": {
                "text": "Places that stay with you",
                "tag": "h2",
                "align": "center",
                "effect": "none"
              },
              "design": {
                "fontFamily": "{{font.heading}}",
                "fontSize": 42,
                "fontWeight": 700,
                "lineHeight": 1.12,
                "letterSpacing": -0.5,
                "mobile": {
                  "fontSize": 30
                },
                "reveal": "fade-up"
              }
            }
          ]
        },
        {
          "label": "Slides",
          "width": 12,
          "layout": {
            "gap": 0
          },
          "blocks": [
            {
              "blockType": "section",
              "design": {
                "layout": {
                  "display": "carousel",
                  "carouselPerView": 1,
                  "carouselGap": 24,
                  "carouselArrows": true,
                  "contentWidth": "boxed",
                  "boxedWidth": 1100
                }
              },
              "columns": [
                {
                  "label": "Morning light on the ridge",
                  "width": 12,
                  "layout": {
                    "gap": 8
                  },
                  "blocks": [
                    {
                      "blockType": "element",
                      "elementType": "image",
                      "props": {
                        "image": "img:mountains@1600|Morning light on the ridge",
                        "alt": "Morning light on the ridge",
                        "caption": "Morning light on the ridge",
                        "ratio": "16:9",
                        "fit": "cover",
                        "width": 100,
                        "align": "center"
                      },
                      "design": {
                        "borderRadius": "{{radius}}",
                        "boxShadow": "lg"
                      }
                    }
                  ]
                },
                {
                  "label": "Green valley trail",
                  "width": 12,
                  "layout": {
                    "gap": 8
                  },
                  "blocks": [
                    {
                      "blockType": "element",
                      "elementType": "image",
                      "props": {
                        "image": "img:nature@1600|Green valley trail",
                        "alt": "Green valley trail",
                        "caption": "Green valley trail",
                        "ratio": "16:9",
                        "fit": "cover",
                        "width": 100,
                        "align": "center"
                      },
                      "design": {
                        "borderRadius": "{{radius}}",
                        "boxShadow": "lg"
                      }
                    }
                  ]
                },
                {
                  "label": "Quiet beach at dusk",
                  "width": 12,
                  "layout": {
                    "gap": 8
                  },
                  "blocks": [
                    {
                      "blockType": "element",
                      "elementType": "image",
                      "props": {
                        "image": "img:beach@1600|Quiet beach at dusk",
                        "alt": "Quiet beach at dusk",
                        "caption": "Quiet beach at dusk",
                        "ratio": "16:9",
                        "fit": "cover",
                        "width": 100,
                        "align": "center"
                      },
                      "design": {
                        "borderRadius": "{{radius}}",
                        "boxShadow": "lg"
                      }
                    }
                  ]
                },
                {
                  "label": "Lakeside at sunrise",
                  "width": 12,
                  "layout": {
                    "gap": 8
                  },
                  "blocks": [
                    {
                      "blockType": "element",
                      "elementType": "image",
                      "props": {
                        "image": "img:landscape@1600|Lakeside at sunrise",
                        "alt": "Lakeside at sunrise",
                        "caption": "Lakeside at sunrise",
                        "ratio": "16:9",
                        "fit": "cover",
                        "width": 100,
                        "align": "center"
                      },
                      "design": {
                        "borderRadius": "{{radius}}",
                        "boxShadow": "lg"
                      }
                    }
                  ]
                },
                {
                  "label": "The road to the coast",
                  "width": 12,
                  "layout": {
                    "gap": 8
                  },
                  "blocks": [
                    {
                      "blockType": "element",
                      "elementType": "image",
                      "props": {
                        "image": "img:travel@1600|The road to the coast",
                        "alt": "The road to the coast",
                        "caption": "The road to the coast",
                        "ratio": "16:9",
                        "fit": "cover",
                        "width": 100,
                        "align": "center"
                      },
                      "design": {
                        "borderRadius": "{{radius}}",
                        "boxShadow": "lg"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
