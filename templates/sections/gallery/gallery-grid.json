{
  "meta": {
    "slug": "gallery-grid",
    "kind": "section",
    "category": "gallery",
    "frameworks": [
      "shine",
      "effix"
    ],
    "version": "1.0.0",
    "title": "Six-photo grid with hover zoom",
    "description": "Heading above a three-by-two photo grid. Photos zoom gently on hover and open larger on click; two columns on tablet, one on mobile.",
    "tags": [
      "gallery",
      "grid",
      "photos",
      "hover",
      "lightbox"
    ],
    "industry": [
      "general",
      "agency",
      "personal"
    ],
    "style": "mono"
  },
  "tree": [
    {
      "blockType": "section",
      "design": {
        "paddingTop": 96,
        "paddingBottom": 96,
        "mobile": {
          "paddingTop": 56,
          "paddingBottom": 56
        },
        "fontFamily": "{{font.body}}",
        "bgType": "color",
        "bgColor": "{{color.bg}}",
        "textColor": "{{color.text}}",
        "layout": {
          "display": "columns",
          "direction": {
            "desktop": "column",
            "mobile": "column"
          },
          "gap": {
            "desktop": 40,
            "mobile": 28
          },
          "alignItems": "stretch",
          "contentWidth": "boxed",
          "boxedWidth": 1200
        }
      },
      "columns": [
        {
          "label": "Heading",
          "width": 12,
          "layout": {
            "gap": 12
          },
          "blocks": [
            {
              "blockType": "element",
              "elementType": "heading",
              "props": {
                "text": "Gallery",
                "tag": "h6",
                "align": "center",
                "effect": "none"
              },
              "design": {
                "textColor": "{{color.text}}",
                "textTransform": "uppercase",
                "letterSpacing": 2,
                "fontWeight": 700,
                "fontSize": 13
              }
            },
            {
              "blockType": "element",
              "elementType": "heading",
              "props": {
                "text": "A look around",
                "tag": "h2",
                "align": "center",
                "effect": "none"
              },
              "design": {
                "fontFamily": "{{font.heading}}",
                "fontSize": 42,
                "fontWeight": 700,
                "lineHeight": 1.12,
                "letterSpacing": -0.5,
                "mobile": {
                  "fontSize": 30
                },
                "reveal": "fade-up"
              }
            },
            {
              "blockType": "element",
              "elementType": "text-editor",
              "props": {
                "align": "center",
                "content": "Moments from the studio, the shop floor and the corners we love."
              },
              "design": {
                "textColor": "{{color.muted}}",
                "fontSize": 17,
                "lineHeight": 1.65,
                "reveal": "fade-up",
                "revealDelay": 2
              }
            }
          ]
        },
        {
          "label": "Photos",
          "width": 12,
          "layout": {
            "gap": 0
          },
          "blocks": [
            {
              "blockType": "section",
              "design": {
                "layout": {
                  "display": "grid",
                  "gridColumns": 3,
                  "gridColumnsTablet": 2,
                  "gridColumnsMobile": 1,
                  "gridGap": 16,
                  "gridGapMobile": 20,
                  "contentWidth": "boxed",
                  "boxedWidth": 1200
                }
              },
              "columns": [
                {
                  "label": "Boutique shopfront",
                  "width": 4,
                  "layout": {
                    "gap": 0
                  },
                  "blocks": [
                    {
                      "blockType": "element",
                      "elementType": "image",
                      "props": {
                        "image": "img:store@900|Boutique shopfront",
                        "alt": "Boutique shopfront",
                        "ratio": "4:3",
                        "fit": "cover",
                        "width": 100,
                        "align": "center",
                        "lightbox": true
                      },
                      "design": {
                        "borderRadius": "{{radius}}",
                        "hover": "zoom",
                        "reveal": "fade-up",
                        "revealDelay": 0
                      }
                    }
                  ]
                },
                {
                  "label": "Fresh coffee on the counter",
                  "width": 4,
                  "layout": {
                    "gap": 0
                  },
                  "blocks": [
                    {
                      "blockType": "element",
                      "elementType": "image",
                      "props": {
                        "image": "img:coffee@900|Fresh coffee on the counter",
                        "alt": "Fresh coffee on the counter",
                        "ratio": "3:4",
                        "fit": "cover",
                        "width": 100,
                        "align": "center",
                        "lightbox": true
                      },
                      "design": {
                        "borderRadius": "{{radius}}",
                        "hover": "zoom",
                        "reveal": "fade-up",
                        "revealDelay": 2
                      }
                    }
                  ]
                },
                {
                  "label": "Light-filled interior",
                  "width": 4,
                  "layout": {
                    "gap": 0
                  },
                  "blocks": [
                    {
                      "blockType": "element",
                      "elementType": "image",
                      "props": {
                        "image": "img:interior@900|Light-filled interior",
                        "alt": "Light-filled interior",
                        "ratio": "4:3",
                        "fit": "cover",
                        "width": 100,
                        "align": "center",
                        "lightbox": true
                      },
                      "design": {
                        "borderRadius": "{{radius}}",
                        "hover": "zoom",
                        "reveal": "fade-up",
                        "revealDelay": 4
                      }
                    }
                  ]
                },
                {
                  "label": "Green corner by the window",
                  "width": 4,
                  "layout": {
                    "gap": 0
                  },
                  "blocks": [
                    {
                      "blockType": "element",
                      "elementType": "image",
                      "props": {
                        "image": "img:plant@900|Green corner by the window",
                        "alt": "Green corner by the window",
                        "ratio": "4:3",
                        "fit": "cover",
                        "width": 100,
                        "align": "center",
                        "lightbox": true
                      },
                      "design": {
                        "borderRadius": "{{radius}}",
                        "hover": "zoom",
                        "reveal": "fade-up",
                        "revealDelay": 0
                      }
                    }
                  ]
                },
                {
                  "label": "A tidy workspace",
                  "width": 4,
                  "layout": {
                    "gap": 0
                  },
                  "blocks": [
                    {
                      "blockType": "element",
                      "elementType": "image",
                      "props": {
                        "image": "img:desk@900|A tidy workspace",
                        "alt": "A tidy workspace",
                        "ratio": "3:4",
                        "fit": "cover",
                        "width": 100,
                        "align": "center",
                        "lightbox": true
                      },
                      "design": {
                        "borderRadius": "{{radius}}",
                        "hover": "zoom",
                        "reveal": "fade-up",
                        "revealDelay": 2
                      }
                    }
                  ]
                },
                {
                  "label": "Architectural detail",
                  "width": 4,
                  "layout": {
                    "gap": 0
                  },
                  "blocks": [
                    {
                      "blockType": "element",
                      "elementType": "image",
                      "props": {
                        "image": "img:architecture@900|Architectural detail",
                        "alt": "Architectural detail",
                        "ratio": "4:3",
                        "fit": "cover",
                        "width": 100,
                        "align": "center",
                        "lightbox": true
                      },
                      "design": {
                        "borderRadius": "{{radius}}",
                        "hover": "zoom",
                        "reveal": "fade-up",
                        "revealDelay": 4
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
