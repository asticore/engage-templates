{
  "meta": {
    "slug": "testimonials-carousel-quote",
    "kind": "section",
    "category": "testimonials",
    "frameworks": [
      "shine",
      "effix"
    ],
    "version": "1.0.0",
    "title": "Quote carousel",
    "description": "One large centered quote per slide with a round portrait and stars; arrows move between three slides.",
    "tags": [
      "testimonials",
      "carousel",
      "quote",
      "centered",
      "animated"
    ],
    "industry": [
      "restaurant",
      "health",
      "general"
    ],
    "style": "forest"
  },
  "tree": [
    {
      "blockType": "section",
      "design": {
        "bgType": "color",
        "textColor": "{{color.text}}",
        "fontFamily": "{{font.body}}",
        "paddingTop": 112,
        "paddingBottom": 112,
        "mobile": {
          "paddingTop": 56,
          "paddingBottom": 56
        },
        "bgColor": "{{color.surface}}",
        "reveal": "fade",
        "layout": {
          "display": "carousel",
          "direction": {
            "desktop": "row",
            "mobile": "column"
          },
          "gap": {
            "desktop": 32,
            "mobile": 24
          },
          "contentWidth": "boxed",
          "boxedWidth": 1000,
          "carouselPerView": 1,
          "carouselGap": 24,
          "carouselArrows": true
        }
      },
      "columns": [
        {
          "label": "Helena Marsh",
          "width": 12,
          "layout": {
            "gap": 20,
            "alignSelf": "center"
          },
          "design": {
            "textAlign": "center",
            "paddingLeft": 56,
