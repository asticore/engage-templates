{
  "meta": {
    "slug": "commerce-product-cards",
    "kind": "section",
    "category": "commerce",
    "frameworks": [
      "shine",
      "effix"
    ],
    "version": "1.0.0",
    "title": "Four product cards with price and buttons",
    "description": "Four product photo cards, each with name, price and an Add to cart button linking to the product page. Four across on desktop, two on tablet, one on mobile.",
    "tags": [
      "commerce",
      "products",
      "cards",
      "grid",
      "price"
    ],
    "industry": [
      "ecommerce"
    ],
    "style": "shine-light"
  },
  "tree": [
    {
      "blockType": "section",
      "design": {
        "paddingTop": 96,
        "paddingBottom": 96,
        "mobile": {
          "paddingTop": 56,
          "paddingBottom": 56
        },
        "fontFamily": "{{font.body}}",
        "bgType": "color",
        "bgColor": "{{color.bg}}",
        "textColor": "{{color.text}}",
        "layout": {
          "display": "columns",
          "direction": {
            "desktop": "column",
            "mobile": "column"
          },
          "gap": {
            "desktop": 40,
            "mobile": 28
          },
          "alignItems": "stretch",
          "contentWidth": "boxed",
          "boxedWidth": 1240
        }
      },
      "columns": [
        {
          "label": "Heading",
          "width": 12,
          "layout": {
            "gap": 12
          },
          "blocks": [
            {
              "blockType": "element",
              "elementType": "heading",
              "props": {
                "text": "Best sellers",
                "tag": "h6",
                "align": "center",
                "effect": "none"
              },
              "design": {
                "textColor": "{{color.primary}}",
                "textTransform": "uppercase",
                "letterSpacing": 2,
                "fontWeight": 700,
                "fontSize": 13
              }
            },
            {
              "blockType": "element",
              "elementType": "heading",
              "props": {
                "text": "Loved by our customers",
                "tag": "h2",
                "align": "center",
                "effect": "none"
              },
              "design": {
                "fontFamily": "{{font.heading}}",
                "fontSize": 42,
                "fontWeight": 700,
                "lineHeight": 1.12,
                "letterSpacing": -0.5,
                "mobile": {
                  "fontSize": 30
                },
                "reveal": "fade-up"
              }
            }
          ]
        },
        {
          "label": "Products",
          "width": 12,
          "layout": {
            "gap": 0
          },
          "blocks": [
            {
              "blockType": "section",
              "design": {
                "layout": {
                  "display": "grid",
                  "gridColumns": 4,
                  "gridColumnsTablet": 2,
                  "gridColumnsMobile": 1,
                  "gridGap": 24,
                  "gridGapMobile": 20,
                  "contentWidth": "boxed",
                  "boxedWidth": 1200,
                  "gridAlign": "stretch"
                }
              },
              "columns": [
                {
                  "label": "Meridian Watch",
                  "width": 3,
                  "layout": {
                    "gap": 12
                  },
                  "design": {
                    "reveal": "fade-up",
                    "revealDelay": 0
                  },
                  "blocks": [
                    {
                      "blockType": "element",
                      "elementType": "image",
                      "props": {
                        "image": "img:watch@700|Meridian Watch",
                        "alt": "Meridian Watch",
                        "ratio": "1:1",
                        "fit": "cover",
                        "width": 100,
                        "align": "center"
                      },
                      "design": {
                        "borderRadius": "{{radius}}",
                        "hover": "zoom"
                      }
                    },
                    {
                      "blockType": "element",
                      "elementType": "heading",
                      "props": {
                        "text": "Meridian Watch",
                        "tag": "h3",
                        "align": "left",
                        "effect": "none"
                      },
                      "design": {
                        "fontFamily": "{{font.heading}}",
                        "fontSize": 20,
                        "fontWeight": 700
                      }
                    },
                    {
                      "blockType": "element",
                      "elementType": "heading",
                      "props": {
                        "text": "$189",
                        "tag": "h6",
                        "align": "left",
                        "effect": "none"
                      },
                      "design": {
                        "textColor": "{{color.primary}}",
                        "fontSize": 18,
                        "fontWeight": 700
                      }
                    },
                    {
                      "blockType": "element",
                      "elementType": "button",
                      "props": {
                        "text": "Add to cart",
                        "url": "/shop/meridian-watch",
                        "variant": "primary",
                        "size": "md",
                        "align": "left"
                      }
                    }
                  ]
                },
                {
                  "label": "Halo Headphones",
                  "width": 3,
                  "layout": {
                    "gap": 12
                  },
                  "design": {
                    "reveal": "fade-up",
                    "revealDelay": 2
                  },
                  "blocks": [
                    {
                      "blockType": "element",
                      "elementType": "image",
                      "props": {
                        "image": "img:headphones@700|Halo Headphones",
                        "alt": "Halo Headphones",
                        "ratio": "1:1",
                        "fit": "cover",
                        "width": 100,
                        "align": "center"
                      },
                      "design": {
                        "borderRadius": "{{radius}}",
                        "hover": "zoom"
                      }
                    },
                    {
                      "blockType": "element",
                      "elementType": "heading",
                      "props": {
                        "text": "Halo Headphones",
                        "tag": "h3",
                        "align": "left",
                        "effect": "none"
                      },
                      "design": {
                        "fontFamily": "{{font.heading}}",
                        "fontSize": 20,
                        "fontWeight": 700
                      }
                    },
                    {
                      "blockType": "element",
                      "elementType": "heading",
                      "props": {
                        "text": "$149",
                        "tag": "h6",
                        "align": "left",
                        "effect": "none"
                      },
                      "design": {
                        "textColor": "{{color.primary}}",
                        "fontSize": 18,
                        "fontWeight": 700
                      }
                    },
                    {
                      "blockType": "element",
                      "elementType": "button",
                      "props": {
                        "text": "Add to cart",
                        "url": "/shop/halo-headphones",
                        "variant": "primary",
                        "size": "md",
                        "align": "left"
                      }
                    }
                  ]
                },
                {
                  "label": "Stride Runner",
                  "width": 3,
                  "layout": {
                    "gap": 12
                  },
                  "design": {
                    "reveal": "fade-up",
                    "revealDelay": 4
                  },
                  "blocks": [
                    {
                      "blockType": "element",
                      "elementType": "image",
                      "props": {
                        "image": "img:shoe@700|Stride Runner",
                        "alt": "Stride Runner",
                        "ratio": "1:1",
                        "fit": "cover",
                        "width": 100,
                        "align": "center"
                      },
                      "design": {
                        "borderRadius": "{{radius}}",
                        "hover": "zoom"
                      }
                    },
                    {
                      "blockType": "element",
                      "elementType": "heading",
                      "props": {
                        "text": "Stride Runner",
                        "tag": "h3",
                        "align": "left",
                        "effect": "none"
                      },
                      "design": {
                        "fontFamily": "{{font.heading}}",
                        "fontSize": 20,
                        "fontWeight": 700
                      }
                    },
                    {
                      "blockType": "element",
                      "elementType": "heading",
                      "props": {
                        "text": "$120",
                        "tag": "h6",
                        "align": "left",
                        "effect": "none"
                      },
                      "design": {
                        "textColor": "{{color.primary}}",
                        "fontSize": 18,
                        "fontWeight": 700
                      }
                    },
                    {
                      "blockType": "element",
                      "elementType": "button",
                      "props": {
                        "text": "Add to cart",
                        "url": "/shop/stride-runner",
                        "variant": "primary",
                        "size": "md",
                        "align": "left"
                      }
                    }
                  ]
                },
                {
                  "label": "Frame Instant Camera",
                  "width": 3,
                  "layout": {
                    "gap": 12
                  },
                  "design": {
                    "reveal": "fade-up",
                    "revealDelay": 6
                  },
                  "blocks": [
                    {
                      "blockType": "element",
                      "elementType": "image",
                      "props": {
                        "image": "img:camera@700|Frame Instant Camera",
                        "alt": "Frame Instant Camera",
                        "ratio": "1:1",
                        "fit": "cover",
                        "width": 100,
                        "align": "center"
                      },
                      "design": {
                        "borderRadius": "{{radius}}",
                        "hover": "zoom"
                      }
                    },
                    {
                      "blockType": "element",
                      "elementType": "heading",
                      "props": {
                        "text": "Frame Instant Camera",
                        "tag": "h3",
                        "align": "left",
                        "effect": "none"
                      },
                      "design": {
                        "fontFamily": "{{font.heading}}",
                        "fontSize": 20,
                        "fontWeight": 700
                      }
                    },
                    {
                      "blockType": "element",
                      "elementType": "heading",
                      "props": {
                        "text": "$95",
                        "tag": "h6",
                        "align": "left",
                        "effect": "none"
                      },
                      "design": {
                        "textColor": "{{color.primary}}",
                        "fontSize": 18,
                        "fontWeight": 700
                      }
                    },
                    {
                      "blockType": "element",
                      "elementType": "button",
                      "props": {
                        "text": "Add to cart",
                        "url": "/shop/frame-camera",
                        "variant": "primary",
                        "size": "md",
                        "align": "left"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
