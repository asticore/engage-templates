{
  "meta": {
    "slug": "blog-three-cards",
    "kind": "section",
    "category": "blog",
    "frameworks": [
      "shine",
      "effix"
    ],
    "version": "1.0.0",
    "title": "Three article cards with view-all button",
    "description": "Heading with three image cards (photo, title, teaser, read link) and a View all button below. Cards lift on hover; they stack on mobile.",
    "tags": [
      "blog",
      "cards",
      "articles",
      "grid",
      "photo"
    ],
    "industry": [
      "media",
      "agency",
      "general"
    ],
    "style": "candy"
  },
  "tree": [
    {
      "blockType": "section",
      "design": {
        "paddingTop": 96,
        "paddingBottom": 96,
        "mobile": {
          "paddingTop": 56,
          "paddingBottom": 56
        },
        "fontFamily": "{{font.body}}",
        "bgType": "color",
        "bgColor": "{{color.surface}}",
        "textColor": "{{color.text}}",
        "layout": {
          "display": "columns",
          "direction": {
            "desktop": "column",
            "mobile": "column"
          },
          "gap": {
            "desktop": 48,
            "mobile": 28
          },
          "alignItems": "stretch",
          "contentWidth": "boxed",
          "boxedWidth": 1200
        }
      },
      "columns": [
        {
          "label": "Heading",
          "width": 12,
          "layout": {
            "gap": 12
          },
          "blocks": [
            {
              "blockType": "element",
              "elementType": "heading",
              "props": {
                "text": "From the journal",
                "tag": "h6",
                "align": "center",
                "effect": "none"
              },
              "design": {
                "textColor": "{{color.primary}}",
                "textTransform": "uppercase",
                "letterSpacing": 2,
                "fontWeight": 700,
                "fontSize": 13
              }
            },
            {
              "blockType": "element",
              "elementType": "heading",
              "props": {
                "text": "Fresh reading for curious minds",
                "tag": "h2",
                "align": "center",
                "effect": "none"
              },
              "design": {
                "fontFamily": "{{font.heading}}",
                "fontSize": 42,
                "fontWeight": 700,
                "lineHeight": 1.12,
                "letterSpacing": -0.5,
                "mobile": {
                  "fontSize": 30
                },
                "reveal": "fade-up"
              }
            }
          ]
        },
        {
          "label": "Cards",
          "width": 12,
          "layout": {
            "gap": 0
          },
          "blocks": [
            {
              "blockType": "section",
              "design": {
                "layout": {
                  "display": "grid",
                  "gridColumns": 3,
                  "gridColumnsTablet": 2,
                  "gridColumnsMobile": 1,
                  "gridGap": 28,
                  "gridGapMobile": 20,
                  "contentWidth": "boxed",
                  "boxedWidth": 1200,
                  "gridAlign": "stretch"
                }
              },
              "columns": [
                {
                  "label": "Five habits of calm, productive teams",
                  "width": 4,
                  "layout": {
                    "gap": 0
                  },
                  "blocks": [
                    {
                      "blockType": "element",
                      "elementType": "card",
                      "props": {
                        "media": "image",
                        "imageRatio": "4:3",
                        "imageFit": "cover",
                        "titleTag": "h3",
                        "layout": "top",
                        "align": "left",
                        "bgColour": "{{color.bg}}",
                        "borderRadius": "{{radius}}",
                        "shadow": "sm",
                        "hoverEffect": "lift",
                        "image": "img:workspace@900|Five habits of calm, productive teams",
                        "title": "Five habits of calm, productive teams",
                        "text": "Small routines that cut meeting time and make room for deep work.",
                        "link": {
                          "url": "/blog/calm-teams"
                        },
                        "linkLabel": "Read article"
                      },
                      "design": {
                        "reveal": "fade-up",
                        "revealDelay": 0
                      }
                    }
                  ]
                },
                {
                  "label": "Reading your numbers without the noise",
                  "width": 4,
                  "layout": {
                    "gap": 0
                  },
                  "blocks": [
                    {
                      "blockType": "element",
                      "elementType": "card",
                      "props": {
                        "media": "image",
                        "imageRatio": "4:3",
                        "imageFit": "cover",
                        "titleTag": "h3",
                        "layout": "top",
                        "align": "left",
                        "bgColour": "{{color.bg}}",
                        "borderRadius": "{{radius}}",
                        "shadow": "sm",
                        "hoverEffect": "lift",
                        "image": "img:analytics@900|Reading your numbers without the noise",
                        "title": "Reading your numbers without the noise",
                        "text": "Which three metrics are worth checking each week, and which to ignore.",
                        "link": {
                          "url": "/blog/reading-numbers"
                        },
                        "linkLabel": "Read article"
                      },
                      "design": {
                        "reveal": "fade-up",
                        "revealDelay": 2
                      }
                    }
                  ]
                },
                {
                  "label": "How to run a decision meeting",
                  "width": 4,
                  "layout": {
                    "gap": 0
                  },
                  "blocks": [
                    {
                      "blockType": "element",
                      "elementType": "card",
                      "props": {
                        "media": "image",
                        "imageRatio": "4:3",
                        "imageFit": "cover",
                        "titleTag": "h3",
                        "layout": "top",
                        "align": "left",
                        "bgColour": "{{color.bg}}",
                        "borderRadius": "{{radius}}",
                        "shadow": "sm",
                        "hoverEffect": "lift",
                        "image": "img:meeting@900|How to run a decision meeting",
                        "title": "How to run a decision meeting",
                        "text": "A simple agenda that gets to a clear yes or no in thirty minutes.",
                        "link": {
                          "url": "/blog/decision-meetings"
                        },
                        "linkLabel": "Read article"
                      },
                      "design": {
                        "reveal": "fade-up",
                        "revealDelay": 4
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "Button",
          "width": 12,
          "layout": {
            "gap": 0
          },
          "blocks": [
            {
              "blockType": "element",
              "elementType": "button",
              "props": {
                "text": "View all articles",
                "url": "/blog",
                "variant": "secondary",
                "size": "lg",
                "align": "center"
              }
            }
          ]
        }
      ]
    }
  ]
}
